# ===== 必填：MySQL =====
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=chat
MYSQL_USER=chat
MYSQL_PASSWORD=change-me

# ===== 必填：MinIO =====
MINIO_ENDPOINT=http://YOUR_PUBLIC_IP:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me

# ===== 必填：邮件 SMTP =====
MAIL_HOST=smtp.163.com
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-auth-code

# ===== 应用密钥 =====
JWT_SECRET=replace-with-at-least-32-random-characters
AES_KEY=replace-with-16-24-or-32-byte-key
ROCKET_NAME_SERVER=rmqnamesrv:9876

# ===== LiveKit 多人通话 =====
# 当前 Compose 未配置 TLS，使用 ws；若前端站点为 HTTPS，请改为带可信证书的 wss 地址。
LIVEKIT_PUBLIC_IP=YOUR_PUBLIC_IP
LIVEKIT_HOST=ws://YOUR_PUBLIC_IP:7880
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_TOKEN_TTL_MINUTES=60

# ===== Pushy 离线推送 =====
PUSHY_API_KEY=replace-with-pushy-secret-api-key
PUSHY_TIME_TO_LIVE=2592000
